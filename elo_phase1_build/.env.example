# Parent Dashboard -> Pi Core
ELO_CORE_HOST=0.0.0.0
ELO_CORE_PORT=8090
ELO_CORE_CORS_ORIGIN=*

# Existing AI backend robot WebSocket
BACKEND_WS_URL=ws://YOUR-BACKEND-HOST:8000/ws/robot
ROBOT_DEVICE_TOKEN=PUT_ROBOT_DEVICE_TOKEN_HERE

# Proven Pi audio devices
AUDIO_CAPTURE_DEVICE=plughw:ELOAUDIO,0
AUDIO_PLAYBACK_DEVICE=plughw:ELOAUDIO,1
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_MAX_SECONDS=20

# Existing ESP32 Face V3 UART
ESP32_SERIAL_PORT=/dev/ttyAMA0
ESP32_BAUDRATE=460800
ESP32_DISPLAY_FPS=25

BACKEND_TIMEOUT_S=30
